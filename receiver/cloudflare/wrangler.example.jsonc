{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simile-report-receiver",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-22",
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_SERVICES": "inttegro",
    "CONTACT_RETENTION_DAYS": "90",
    "EVIDENCE_RETENTION_DAYS": "180",
    "MAX_REPORT_BYTES": "8388608",
    "QUARANTINE_RETENTION_DAYS": "30",
    "REPORTER_CONTACT_KEY_VERSION": "v1"
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "ratelimits": [
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simile-reports",
      "database_id": "replace-with-d1-database-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "simile-report-evidence"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "VERIFICATION_QUEUE",
        "queue": "simile-report-verification"
      }
    ],
    "consumers": [
      {
        "queue": "simile-report-verification",
        "max_batch_size": 4,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "simile-report-verification-dead"
      }
    ]
  },
  "services": [
    {
      "binding": "VERIFIER",
      "service": "simile-report-verifier"
    }
  ]
}
